  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <DataSourceReference>DataSourceDiploma</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bd4ff777-4690-4d69-98a6-9ae2b5c3633a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@streamid">
            <Value>=Parameters!streamid.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@csno">
            <Value>=Parameters!csno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
    a.rollNo,
    ar.rank AS arank,
    a.name,
    a.categoryId,
    MD_Category.description AS Categ,
    MG.description AS sex,
    MD_Domicile.description AS state,
    MS.description AS QualExamState,
    REPLACE
    (
        STUFF
        (
            (
                SELECT  
                ',' + CONVERT(VARCHAR(5), CC.optNo) 
                + '-' + ISNULL(IM.description, '')
                + '-' + ISNULL(M.description, '')
                + ' (' + Case when ISNULL(CC.isValid, 'Y') = 'Y' THEN 'Valid Choice' ELSE 'Invalid Choice' END
                + ')'
                FROM App_Choice CC

                INNER JOIN MD_Institute IM
                    ON IM.id = CC.instituteId AND CC.boardId = IM.boardId and IM.Stream_Code=@streamid

                INNER JOIN MD_Program M
                    ON M.id = CC.programId AND CC.boardId = M.boardId  and M.Stream_Code=@streamid

                WHERE cc.rollNo = a.rollNo AND a.boardId = cc.boardId
                  AND cc.optNo &lt;= 10 AND cc.roundNo = @csno

                FOR XML PATH('')
            ),
            1,
            1,
            ''
        ),
        '&amp;amp;',
        'and'
    ) AS choices

FROM app_candidateprofile a

INNER JOIN MD_Gender MG ON
    a.genderId = MG.id AND a.boardId = MG.boardId

INNER JOIN MD_Category
    ON a.categoryId = MD_Category.id AND a.boardId = MD_Category.boardId

INNER JOIN MD_Domicile
    ON a.domicileId = MD_Domicile.id AND a.boardId = MD_Domicile.boardId

INNER JOIN app_rankdetail Ar
    ON a.rollno = ar.rollno
   AND ar.streamId = @streamid AND a.boardId = Ar.boardId AND Ar.roundNo = @csno

INNER JOIN App_QualificationMarksDetail AP ON a.boardId = AP.boardId
    AND a.rollno = AP.rollNo 
    AND (
        (AP.Stream_Code = '60'AND AP.qualificationId IN ('03')) OR
        (AP.Stream_Code = '87'AND AP.qualificationId IN ('04')) OR
        (AP.Stream_Code = '85'AND AP.qualificationId IN ('16', '17', '19', '76', '77', '78')) OR
        (AP.Stream_Code = '89'AND AP.qualificationId IN ('17', '80', '81', '82', '83', '84')) OR
        (AP.Stream_Code = '88'AND AP.qualificationId IN ('78', '79'))
    )
INNER JOIN MD_State MS 
    ON MS.id = AP.qualExamState

WHERE a.rollNo NOT IN
(
    SELECT rollNo
    FROM App_Allotment
    WHERE roundNo = @csno
      AND streamId = @streamid AND boardId = a.boardId
)

AND a.rollNo IN
(
    SELECT DISTINCT rollNo
    FROM App_Choice
)

ORDER BY ar.rank</CommandText>
      </Query>
      <Fields>
        <Field Name="rollno">
          <DataField>rollNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="arank">
          <DataField>arank</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="categoryId">
          <DataField>categoryId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Categ">
          <DataField>Categ</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="sex">
          <DataField>sex</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="state">
          <DataField>state</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QualExamState">
          <DataField>QualExamState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="choices">
          <DataField>choices</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText>SELECT id,description 
FROM MD_Stream WHERE examTypeId = 53;</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
