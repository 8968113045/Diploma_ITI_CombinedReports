  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceITI">
      <DataSourceReference>DataSourceITI</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bd4ff777-4690-4d69-98a6-9ae2b5c3633a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceITI</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@csno">
            <Value>=Parameters!csno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF (EXISTS (SELECT *
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'dbo'
AND TABLE_NAME = 'aa'))
BEGIN
    drop table aa
END

SELECT rollno,roundno, [14],[17],[20] into aa FROM   
(SELECT rollno, rankTypeId,rank,roundno FROM app_rankdetail where rank&lt;&gt;0  )Tab1  
PIVOT  
(  
avg([rank]) FOR ranktypeid IN ([14],[17],[20])) AS Tab2  
order by rollNo

SELECT distinct a.rollNo, 'Rank_8th= '+CONVERT(varchar(13), a.[14]) as rank8th,
'Rank_10th= '+CONVERT(varchar(13), a.[17] ) as rank10th,
'Rank_Cutting= '+CONVERT(varchar(13), a.[20]) as rank20th,
b.name,b.categoryId,MD_Category.description as Categ,MD_Gender.description AS sex,MD_Domicile.description AS state ,
REPLACE(Stuff( (SELECT   ',' +  CONVERT(varchar(5), CC.optNo) + '-' +( SELECT      description  Inst_Name    FROM   MD_Institute AS IM    
WHERE        (IM.id = CC.instituteId)) + '-' +  (SELECT    M.description Course_Name   FROM  MD_Program AS M   WHERE  (M.id = CC.programId))  
FROM  App_Choice AS CC  WHERE    (cc.rollNo = a.rollNo) AND (cc.optNo &lt;= 5)  For XML Path('')),1,1,''),'&amp;amp;','and')   AS choices
FROM  aa AS a 
INNER JOIN  App_CandidateProfile AS b ON a.rollNo = b.rollno 
INNER JOIN  MD_Category ON b.categoryId = MD_Category.id 
INNER JOIN  MD_Gender ON b.genderid = MD_Gender.id 
INNER JOIN  MD_Domicile ON b.domicileId = MD_Domicile.id 
WHERE  --a.roundno=@csno and
a.rollNo NOT IN  (SELECT  rollNo From App_Allotment  WHERE  roundNo = @csno)
AND a.rollNo IN (SELECT DISTINCT rollNo  From App_Choice) 
order by rollno


--SELECT * FROM AA</CommandText>
      </Query>
      <Fields>
        <Field Name="rollno">
          <DataField>rollNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rank8th">
          <DataField>rank8th</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rank10th">
          <DataField>rank10th</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rank20th">
          <DataField>rank20th</DataField>
