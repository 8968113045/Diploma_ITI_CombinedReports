  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PSBTECOUNS">
      <DataSourceReference>DataSourceDiploma</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7d1f3ba9-4d57-4dcf-8c60-b1c5d06baa18</rd:DataSourceID>
    </DataSource>
    <DataSource Name="DataSource1">
      <DataSourceReference>DataSourceDiploma</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4222026e-f895-44cb-87b2-c4fc393b9b3d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@streamid">
            <Value>=Parameters!streamId.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
A.rollno, 
A.Name,
A.FName, 
A.DOB,
B.rank as rank,
e.percentageMarks,
C.description as Stream
from App_RankDetail B
JOIN App_QualificationMarksDetail e on b.rollno = e.rollno and e.boardId = B.boardId and B.streamId = @streamid
JOIN app_candidateprofile A on A.rollno = b.rollNo and A.boardId = e.boardId
Join MD_Stream C ON B.streamId = C.id AND B.boardId = C.boardId
WHERE
(
	(
		e.Stream_Code = 60 AND e.qualificationId = '03'
	) OR
	(
		e.Stream_Code = 87 AND e.qualificationId = '04'
	) OR
	(
		e.Stream_Code = 85 AND 
		(
			e.qualificationId = '17' OR
			(e.qualificationId &lt;&gt; '17' AND 
				(e.qualificationId IN ('16', '76', '77', '78') OR 
					(e.qualificationId = '19'
					AND EXISTS (
									SELECT 1 FROM App_QualificationSubjectMarksDetail AM
									JOIN MD_QualificationSubject MS ON AM.boardId = MS.boardId AND AM.qualificationId = MS.qualificationId AND AM.subjectId = MS.id AND MS.streamList = e.Stream_Code
									where AM.qualificationid = e.qualificationId AND passStatus = '01' AND AM.rollNo = e.rollNo
								)
					)
				)
			)
		)
	) OR
	(
		e.Stream_Code = 89 AND 
		(
			e.qualificationId = '17' OR
			(e.qualificationId &lt;&gt; '17' AND 
				(e.qualificationId IN ('81', '82', '83', '84') OR 
					(e.qualificationId = '80' 
					AND EXISTS (
									SELECT 1 FROM App_QualificationSubjectMarksDetail AM
									JOIN MD_QualificationSubject MS ON AM.boardId = MS.boardId AND AM.qualificationId = MS.qualificationId AND AM.subjectId = MS.id AND MS.streamList = e.Stream_Code
									where AM.qualificationid = e.qualificationId AND passStatus = '01' AND AM.rollNo = e.rollNo
								)
					)
				)
			)
		) AND
			EXISTS
			(
				SELECT 1 FROM App_AdditionalExperience a WHERE a.boardId = e.boardId and a.rollNo = e.rollNo AND a.roundNo = e.roundNo AND CAST(expMonth AS INT) &gt;= 12
			)
	) OR
	(
		e.Stream_Code = 88 AND 
		(
			e.qualificationId IN ('79', '78')  
		)
	)
)
order by B.rank</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="rollno">
          <DataField>rollno</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fName">
          <DataField>FName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DOB">
          <DataField>DOB</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rank">
          <DataField>rank</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="percentageMarks">
          <DataField>percentageMarks</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Stream">
          <DataField>Stream</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>PSBTECOUNS</DataSourceName>
        <CommandText>SELECT id,description 
FROM MD_Stream WHERE examTypeId = 53;</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
