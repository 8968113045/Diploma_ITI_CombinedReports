<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DIV1-PAWAN-GF;Initial Catalog=ItiDB21072022</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>50ba5149-f918-4b27-bce6-183dc0d27eb1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@roundno">
            <Value>=Parameters!roundno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        App_Seat.roundNo, MD_Institute.description AS InstituteName, MD_Program.description AS CourseName, MD_Quota.description AS SeatType, MD_SeatCategory.description AS SeatCategory, App_Seat.genderId AS SeatGender, 
                         App_Seat.tSeat, App_Seat.aSeat
FROM            App_Seat INNER JOIN
                         MD_Institute ON MD_Institute.boardId = App_Seat.boardId AND MD_Institute.id = App_Seat.instituteId INNER JOIN
                         MD_Program ON MD_Program.boardId = App_Seat.boardId AND MD_Program.id = App_Seat.programId INNER JOIN
                         MD_Quota ON MD_Quota.boardId = App_Seat.boardId AND MD_Quota.id = App_Seat.quotaId INNER JOIN
                         MD_SeatCategory ON MD_SeatCategory.boardId = App_Seat.boardId AND MD_SeatCategory.id = App_Seat.categoryId
where App_Seat.roundNo=@roundno
GROUP BY App_Seat.roundNo, MD_Institute.description, MD_Program.description, MD_Quota.description, MD_SeatCategory.description, App_Seat.genderId, App_Seat.tSeat, App_Seat.aSeat
ORDER BY App_Seat.roundNo, InstituteName, CourseName, SeatType, SeatCategory, SeatGender</CommandText>
      </Query>
      <Fields>
        <Field Name="roundNo">
          <DataField>roundNo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InstituteName">
          <DataField>InstituteName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CourseName">
          <DataField>CourseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SeatType">
          <DataField>SeatType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SeatCategory">
          <DataField>SeatCategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SeatGender">
          <DataField>SeatGender</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tSeat">
          <DataField>tSeat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="aSeat">
          <DataField>aSeat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
