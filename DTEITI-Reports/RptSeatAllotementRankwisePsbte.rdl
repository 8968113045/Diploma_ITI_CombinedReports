  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@streamid">
            <Value>=Parameters!streamid.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@csno">
            <Value>=Parameters!csno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT  DISTINCT
REPLACE(
    STUFF(
        (
            SELECT  
    ',' + CONVERT(VARCHAR(5), CC.optNo) 
    + '-' + ISNULL(IM.description, '')
    + '-' + ISNULL(M.description, '')
    + ' (' + Case when ISNULL(CC.isValid, 'Y') = 'Y' THEN 'Valid Choice' ELSE 'Invalid Choice' END
    + ')'
            FROM App_Choice AS CC
            INNER JOIN MD_Institute IM 
                ON IM.id = CC.instituteId AND CC.boardId = IM.boardId and IM.Stream_Code=@streamid 
            INNER JOIN MD_Program M 
                ON M.id = CC.programId AND M.boardId = CC.boardId and M.Stream_Code=@streamid
            WHERE cc.rollNo = aa.rollNo AND aa.boardId = cc.boardId AND cc.optNo &lt;= 10
            FOR XML PATH('')
        ),
        1,
        1,
        ''
    ),
    '&amp;amp;',
    'and'
) AS choices,
candidate.name,
AP.course,
AA.ranktypeId,
AA.rollNo AS roll,
AA.rank AS ASrank,
AA.isWithdrawn,
AA.reportingStatus,
CASE WHEN AA.reportingStatus IN ('RU', 'RT') THEN 
REPLACE(
    STUFF(
        (
            SELECT  TOP 1
    ',' + CONVERT(VARCHAR(5), CC.optionNo) 
    + ' - ' + LTRIM(RTRIM(ISNULL(IM.description, '')))
    + ' - ' + LTRIM(RTRIM(ISNULL(M.description, '')))
            FROM App_Allotment AS CC
            INNER JOIN MD_Institute IM 
                ON IM.id = CC.instituteId AND CC.boardId = IM.boardId and IM.Stream_Code=@streamid 
            INNER JOIN MD_Program M 
                ON M.id = CC.programId AND M.boardId = CC.boardId and M.Stream_Code=@streamid
            WHERE cc.rollNo = aa.rollNo AND aa.boardId = cc.boardId AND roundNo &lt; @csno
            FOR XML PATH('')
        ),
        1,
        1,
        ''
    ),
    '&amp;amp;',
    'and'
) ELSE '' END AS PreviousAllotted,
AA.optionNo AS Alloted_Choice,
Course_Master.description AS programId,
cat.description AS Alloted_Cat,
Institute_Master.description InstituteName,
cat_1.Description AS Candidate_Category,
ST.description AllotedQuota,
dom.description AS Candidate_State,
MS.description AS QualExamState,
AA.reportingStatus AS seatstatus,
aa.seatGenderId as SeatGender,
SubCategory_Master.description [subcat],
MG.description as CandidateGender,

(CASE 
    WHEN aa.roundNo = 1 THEN 'First Counselling' 
    ELSE '' 
END) AS description

FROM App_Allotment AA

INNER JOIN MD_Quota ST 
    ON AA.allottedQuota = ST.id AND AA.boardId = ST.boardId

INNER JOIN MD_SeatCategory cat 
    ON AA.allottedCat = cat.id AND AA.boardId = cat.boardId

INNER JOIN MD_Institute Institute_Master  
    ON AA.instituteId = Institute_Master.id AND AA.boardId = Institute_Master.boardId and Institute_Master.Stream_Code=AA.streamId

INNER JOIN MD_Program Course_Master 
    ON AA.programId = Course_Master.id AND AA.boardId = Course_Master.boardId AND Course_Master.Stream_Code=AA.streamId

INNER JOIN App_CandidateProfile candidate 
    ON AA.rollNo = candidate.rollno AND AA.boardId = candidate.boardId

INNER JOIN MD_Domicile dom 
    ON candidate.domicileId = dom.id AND AA.boardId = dom.boardId

INNER JOIN MD_Gender MG ON MG.id = candidate.genderId AND AA.boardId = MG.boardId

INNER JOIN MD_Category cat_1 
    ON candidate.categoryId = cat_1.id AND AA.boardId = cat_1.boardId

INNER JOIN App_QualificationMarksDetail AP ON candidate.boardId = AP.boardId
    AND candidate.rollno = AP.rollNo 
    AND (
        (AP.Stream_Code = '60'AND AP.qualificationId IN ('03')) OR
        (AP.Stream_Code = '87'AND AP.qualificationId IN ('04')) OR
        (AP.Stream_Code = '85'AND AP.qualificationId IN ('16', '17', '19', '76', '77', '78')) OR
        (AP.Stream_Code = '89'AND AP.qualificationId IN ('17', '80', '81', '82', '83', '84')) OR
        (AP.Stream_Code = '88'AND AP.qualificationId IN ('78', '79'))
    )
INNER JOIN MD_State MS 
    ON MS.id = AP.qualExamState

LEFT OUTER JOIN MD_SubCategory SubCategory_Master 
    ON candidate.subcat = SubCategory_Master.id AND AA.boardId = SubCategory_Master.boardId

WHERE rank &lt;&gt; 0 
  AND aa.roundNo = @csno
  AND aa.streamId = @streamid

ORDER BY aa.rank</CommandText>
      </Query>
      <Fields>
        <Field Name="choices">
          <DataField>choices</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="course">
          <DataField>course</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
