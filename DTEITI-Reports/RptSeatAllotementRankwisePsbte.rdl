  <DataSources>
    <DataSource Name="DataSource">
      <DataSourceReference>DataSourceDiploma</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bd4ff777-4690-4d69-98a6-9ae2b5c3633a</rd:DataSourceID>
