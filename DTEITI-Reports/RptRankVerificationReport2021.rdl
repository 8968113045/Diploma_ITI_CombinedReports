  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceITI">
      <DataSourceReference>DataSourceITI</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>738e7e6d-5fba-4642-8a53-6470a9d60737</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceITI</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ranktypeid">
            <Value>=Parameters!ranktypeid.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
cprf.rollno, 
cprf.Name,
 cprf.FName, 
 cprf.DOB,
 RD.rankTypeId,
 rd.rank,
rd.percen_tot as [Percent_Tot with_class] ,

 rd.wpercen_tot as [Weightage_Percent_with_class] ,
  
   RD.rank as [Rank_with_class] ,
  -- mq.description as Qualification,
    replace(   Stuff((Select (',' + evt.description + ' : ' + AQ.perMarks  ) from App_AdditionalQualification AQ INNER JOIN 
						 MD_Event evt on aq.qualCode=evt.id where RD.rollNo=AQ.rollno and evt.id in ('08','09','11','06') For XML Path('') ), 1, 1, '') ,',',char(13) )
						 AS AdditionalQual1,
						 replace( replace( Stuff((Select (', ' + evt.description + ' : ' + AQ.perMarks ) from App_AdditionalQualification AQ INNER JOIN 
						 MD_Event evt on aq.qualCode=evt.id where RD.rollNo=AQ.rollno and evt.id in ('02','03','10','12','07') For XML Path('') ), 1, 1, ''),',',char(13) ),'&amp;amp;','and')
						 AS AdditionalQual2,
						   replace(   Stuff((Select (',' + evt.description + ' : ' + AQ.perMarks  ) from App_AdditionalQualification AQ INNER JOIN 
						 MD_Event evt on aq.qualCode=evt.id where RD.rollNo=AQ.rollno and evt.id in  (21,18,16,22) For XML Path('') ), 1, 1, '') ,',',char(13) )
						 AS AdditionalQual3,
						 replace( replace( Stuff((Select (', ' + evt.description + ' : ' + AQ.perMarks ) from App_AdditionalQualification AQ INNER JOIN 
						 MD_Event evt on aq.qualCode=evt.id where RD.rollNo=AQ.rollno and evt.id in (19,17,15,14)  For XML Path('') ), 1, 1, ''),',',char(13) ),'&amp;amp;','and')
						 AS AdditionalQual4,
						 cprf.roundNo,
						replace( Stuff((Select (',' + ev.description +' ('+ AEx.expMonth + ' Month ' + AEx.expDays + ' Days )'  ) from App_AdditionalExperience AEx INNER JOIN 
						 MD_Event ev on AEx.qualCode=ev.id where RD.rollNo=AEx.rollno and ev.id in (23,24)  For XML Path('') ), 1, 1, '') ,',',char(13) )
						 AS AdditionalExp

						 ,(select qmast.description from MD_Qualification qmast where  qmast.id=
						 (select Max(qu.qualificationId) from App_QualificationMarksDetail qu 
						 inner join MD_Qualification qm on qu.qualificationId=qm.id  where rd.rollNo=qu.rollNo group by qu.rollNo )) As HighestQualification
FROM App_CandidateProfile AS cprf  
INNER JOIN  App_RankDetail as RD ON cprf.rollno  = RD.rollNo
Left JOIN MD_RankType AS RT ON RD.rankTypeId=RT.id
--WHERE   rankTypeId='14'
WHERE   rankTypeId=@ranktypeid
ORDER BY rd.rank</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="rollno">
          <DataField>rollno</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="fName">
          <DataField>FName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Percent_Tot_with_class">
          <DataField>Percent_Tot with_class</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DOB">
          <DataField>DOB</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rankTypeId">
          <DataField>rankTypeId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rank">
          <DataField>rank</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Weightage_Percent_with_class">
          <DataField>Weightage_Percent_with_class</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Rank_with_class">
          <DataField>Rank_with_class</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AdditionalQual1">
          <DataField>AdditionalQual1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdditionalQual2">
          <DataField>AdditionalQual2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdditionalQual3">
          <DataField>AdditionalQual3</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="roundNo">
          <DataField>roundNo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AdditionalQual4">
          <DataField>AdditionalQual4</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdditionalExp">
          <DataField>AdditionalExp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HighestQualification">
          <DataField>HighestQualification</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
