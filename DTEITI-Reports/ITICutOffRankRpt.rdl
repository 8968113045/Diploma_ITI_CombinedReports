  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RoundNo">
            <Value>=Parameters!RoundNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT '2026' as Year,'125' departmentid,'Punjab State Board of Technical Education, Punjab' as departmentname, MD.description as District,a.boardId,cb.description as [BoardName],
a.roundNo,(case  when a.roundNo=1 then 'Round 1' when a.roundNo=2 then 'Round 2' end)  RoundName
,a.instituteId,i.description as InstituteName,a.programId,p.description AS CourseName,a.streamId,strm.description StreamName ,
a.groupId,sg.description groupName,a.seatTypeId seatType,st.description SeatTypeName,a.allottedQuota,q.description QuotaName,
a.allottedCat categoryId,sl.description Category,
a.seatGenderId as Gender,g.name GenderName,a.ranktypeId, rt.description RankName,min(a.rank) OpeningRank,max(a.rank) as ClosingRank,''                       
FROM  App_Allotment a     
JOIN MD_CounsellingBoard cb on a.boardId=cb.id AND a.roundNo=@RoundNo
JOIN MD_Institute i ON  i.boardId=a.boardId and i.id=a.instituteId
LEFT JOIN MD_District MD ON i.districtId=MD.id and md.stateId=28
JOIN MD_Program p ON  p.boardId =a.boardId and p.id=a.programId
JOIN MD_Stream strm on a.streamId=strm.id
JOIN MD_SeatGroup sg on a.groupId=sg.id
JOIN MD_SeatCatSubcatList sl on a.allottedCat=Left(sl.catSubcat,2)
JOIN MD_SeatGender g on a.seatGenderId=g.id
JOIN MD_RankType rt on a.ranktypeId=rt.id
JOIN MD_Quota q ON  q.boardId =a.boardId and q.id=a.allottedQuota
JOIN MD_SeatType st on a.seatTypeId=st.id
where a.reportingstatus in ('NR','RU')
group by a.boardId,cb.description,a.roundNo,a.instituteId,i.description ,a.programId,p.description,a.streamId,strm.description,
a.groupId,sg.description ,a.seatTypeId ,st.description ,a.allottedQuota,q.description,a.allottedCat,sl.catSubcat,sl.description ,
a.seatGenderId ,g.name ,a.ranktypeId, rt.description,MD.description
order by MD.description, i.description,p.description</CommandText>
      </Query>
