    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource4</DataSourceName>
        <CommandText>select id, description from MD_Stream where examTypeId = 1 order by boardId;</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>DataSource4</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StreamId">
            <Value>=Parameters!StreamId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select loc_code, description FROM (
select distinct Loc_Code, 
CASE 
WHEN Loc_Code = '01' THEN 'Punjab'
WHEN Loc_Code = '02' THEN 'Chandigarh'
WHEN Loc_Code IN ('03', '04') THEN 'Central' END
AS description 
from MD_Institute where stream_code = 60
AND loc_code IN ('01', '02')
UNION
select distinct '03,04' AS Loc_Code, 
'Central' AS description 
from MD_Institute where stream_code = @StreamId
AND loc_code IN ('03', '04')
) a
order by Loc_Code</CommandText>
      </Query>
      <Fields>
        <Field Name="Loc_Code">
          <DataField>loc_code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
