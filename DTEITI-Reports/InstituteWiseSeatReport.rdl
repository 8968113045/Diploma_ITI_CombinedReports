<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DIV1-PAWAN-GF;Initial Catalog=ItiDB21072022</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>5d594c35-4e10-4f3c-8762-2c34e7ecced9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RoundNo">
            <Value>=Parameters!RoundNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT s.roundno,i.description AS Institute, p.description, SUM(ISNULL(s.tSeat, 0)) AS TotalSeat, SUM(ISNULL(s.aSeat, 0)) AS AdmittedSeat, SUM(ISNULL(s.tSeat, 0) - ISNULL(s.aSeat, 0)) AS VacantSeat
FROM App_Seat AS s INNER JOIN
MD_Institute AS i ON s.instituteId = i.id INNER JOIN
MD_Program AS p ON s.programId = p.id
where s.roundno=@RoundNo
GROUP BY s.roundno,i.description, p.description
ORDER BY s.roundno,Institute</CommandText>
      </Query>
      <Fields>
        <Field Name="roundno">
          <DataField>roundno</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Institute">
          <DataField>Institute</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalSeat">
          <DataField>TotalSeat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AdmittedSeat">
          <DataField>AdmittedSeat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="VacantSeat">
          <DataField>VacantSeat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
