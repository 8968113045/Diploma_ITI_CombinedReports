    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceITI</DataSourceName>
        <CommandText>select instname,program,tseat,aseat,tseat-aseat as vseat,cast(100*(cast(aseat as decimal(5,2))/cast(tseat as decimal(5,2))) as decimal(5,2)) as pp,bb,ff,scbb,scff,institutegender,engg,duration from t8 order by instname,program</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
