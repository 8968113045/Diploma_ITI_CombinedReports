  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RoundNo">
            <Value>=Parameters!RoundNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- 1. SSRS Trick: This never runs, but it forces SSRS to discover your fixed columns!
IF 1 = 0
BEGIN
    SELECT 
        CAST(NULL AS NVARCHAR(100)) AS DistrictName,
        CAST(NULL AS INT) AS DistrictID,
        CAST(NULL AS INT) AS instituteId,
        CAST(NULL AS NVARCHAR(250)) AS instituteName,
        CAST(NULL AS INT) AS programId,
        CAST(NULL AS NVARCHAR(250)) AS programName,
        CAST(NULL AS NVARCHAR(50)) AS seatType,
        CAST(NULL AS INT) AS [HS_Scheduled_Caste-Scheduled_Tribe_01_B],
        CAST(NULL AS INT) AS [HS_T-Sunami__03_B],
        CAST(NULL AS INT) AS [HS_Freedom_Fighter_04_B],
        CAST(NULL AS INT) AS [HS_Backward_Area_05_B],
        CAST(NULL AS INT) AS [HS_Border_Area_06_B],
        CAST(NULL AS INT) AS [HS_Sports_Person_07_B],
        CAST(NULL AS INT) AS [HS_Children-Widows_of_Defence_Personnel_08_B],
        CAST(NULL AS INT) AS [HS_Terrorist-Riots_vicitims_09_B],
        CAST(NULL AS INT) AS [HS_Children-Widows_of_Police-Para_military_forces_10_B],
        CAST(NULL AS INT) AS [HS_Handicapped_13_B],
        CAST(NULL AS INT) AS [HS_AIDS_Victim__17_B],
        CAST(NULL AS INT) AS [HS_Cancer_Victim__18_B],
        CAST(NULL AS INT) AS [HS_Single_Girl_Child__19_B],
        CAST(NULL AS INT) AS [HS_Thalassemia__20_B],
        CAST(NULL AS INT) AS [HS_Backward_Classes-OBC_BC_B],
        CAST(NULL AS INT) AS [HS_Open_OP_B],
        CAST(NULL AS INT) AS [HS_Scheduled_Caste-Scheduled_Tribe_01_F],
        CAST(NULL AS INT) AS [HS_T-Sunami__03_F],
        CAST(NULL AS INT) AS [HS_Freedom_Fighter_04_F],
        CAST(NULL AS INT) AS [HS_Backward_Area_05_F],
        CAST(NULL AS INT) AS [HS_Border_Area_06_F],
        CAST(NULL AS INT) AS [HS_Sports_Person_07_F],
        CAST(NULL AS INT) AS [HS_Children-Widows_of_Defence_Personnel_08_F],
        CAST(NULL AS INT) AS [HS_Terrorist-Riots_vicitims_09_F],
        CAST(NULL AS INT) AS [HS_Children-Widows_of_Police-Para_military_forces_10_F],
        CAST(NULL AS INT) AS [HS_Handicapped_13_F],
        CAST(NULL AS INT) AS [HS_Cancer_Victim__18_F],
        CAST(NULL AS INT) AS [HS_Single_Girl_Child__19_F],
        CAST(NULL AS INT) AS [HS_Backward_Classes-OBC_BC_F],
        CAST(NULL AS INT) AS [HS_Open_OP_F],
        CAST(NULL AS INT) AS [OS_Open_OP_B],
        CAST(NULL AS INT) AS [OS_Open_OP_F]
END

-- 2. Regular script setup using your native SSRS parameter directly
DECLARE @cols NVARCHAR(MAX),
        @colsSelect NVARCHAR(MAX),
        @query NVARCHAR(MAX);

-- Build the PIVOT column layout array
SELECT 
    @cols = STUFF((
        SELECT ',' + QUOTENAME(PivotColumn)
        FROM
        (
            SELECT 
                a.quotaId + '_' +
                REPLACE(REPLACE(b.description,' ','_'),'/','-')
                + '_' + a.categoryId + '_' + a.genderId AS PivotColumn,
                CASE a.quotaId WHEN 'HS' THEN 1 WHEN 'OS' THEN 2 ELSE 3 END AS QuotaSort,
                CASE a.genderId WHEN 'B' THEN 1 WHEN 'F' THEN 2 ELSE 3 END AS GenderSort,
                a.categoryId
            FROM App_Seat a
            JOIN MD_SeatCategory b ON a.categoryId = b.id
            WHERE a.roundNo = @RoundNo -- Using SSRS parameter directly
            GROUP BY a.quotaId, b.description, a.categoryId, a.genderId
        ) x
        ORDER BY QuotaSort, GenderSort, categoryId
        FOR XML PATH(''), TYPE
    ).value('.', 'NVARCHAR(MAX)'), 1, 1, '')

-- Build the SELECT statement wrappers
SELECT 
    @colsSelect = STUFF((
        SELECT ',ISNULL(' + QUOTENAME(PivotColumn) + ',''0'') AS ' + QUOTENAME(PivotColumn)
        FROM
        (
            SELECT 
                a.quotaId + '_' +
                REPLACE(REPLACE(b.description,' ','_'),'/','-')
                + '_' + a.categoryId + '_' + a.genderId AS PivotColumn,
                CASE a.quotaId WHEN 'HS' THEN 1 WHEN 'OS' THEN 2 ELSE 3 END AS QuotaSort,
                CASE a.genderId WHEN 'B' THEN 1 WHEN 'F' THEN 2 ELSE 3 END AS GenderSort,
                a.categoryId
            FROM App_Seat a
            JOIN MD_SeatCategory b ON a.categoryId = b.id
            WHERE a.roundNo = @RoundNo -- Using SSRS parameter directly
            GROUP BY a.quotaId, b.description, a.categoryId, a.genderId
        ) x
        ORDER BY QuotaSort, GenderSort, categoryId
        FOR XML PATH(''), TYPE
    ).value('.', 'NVARCHAR(MAX)'), 1, 1, '')

-- 3. Construct the query string. 
-- Note that we embed the actual value of @RoundNo directly into the text block string.
SET @query = '
SELECT 
    DistrictName,
    DistrictID,
    instituteId,
    instituteName,
    programId,
    programName,
    seatType,
    ' + @colsSelect + '
FROM
(
    SELECT 
        MD.description As DistrictName,
        MD.id As DistrictID,
        a.instituteId,
        d.description AS instituteName,
        a.programId,
        c.description AS programName,
        a.seatType,

        a.quotaId + ''_'' +
        REPLACE(REPLACE(b.description,'' '',''_''),''/'',''-'')
        + ''_'' + a.categoryId + ''_'' + a.genderId AS PivotColumn,

        a.tSeat
    FROM App_Seat a
    JOIN MD_Institute d ON a.instituteId = d.id
    LEFT JOIN MD_District MD ON d.districtid = MD.id AND MD.stateId = 28
    JOIN MD_Program c ON a.programId = c.id
    JOIN MD_SeatCategory b ON a.categoryId = b.id
    WHERE a.roundNo = ' + CAST(@RoundNo AS NVARCHAR(10)) + ' 
) src
PIVOT
(
    SUM(tSeat)
    FOR PivotColumn IN (' + @cols + ')
) p
ORDER BY DistrictID, instituteId, programId
'

-- 4. Execute the string directly so SSRS explicitly reads the tracking environment
EXEC(@query);</CommandText>
      </Query>
